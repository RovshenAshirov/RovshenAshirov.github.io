---
const { title, description, lang } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="keywords" content="Software Engineer, Backend Developer, Django, Laravel, Python, PHP, Full-stack Developer, OAuth2, Microservices, Uzbekistan">
    <meta name="author" content="Rovshen Ashirov">

    <!-- Google - Verify ownership-->
    <!-- HTML tag -->
    <meta name="google-site-verification" content="ndx34xs4FsttJDqRDSBbQF9f0UmuAu4bixg7Pgh1SJ4" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Rovshen Ashirov - Backend Software Engineer"/>
    <meta property="og:description" content="Backend Software Engineer specializing in Django & Laravel" />
    <meta property="og:image" content="https://rovshenashirov.github.io/images/profile/avatar.png" />
    <meta property="og:url" content="https://rovshenashirov.github.io/" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Rovshen Ashirov - Backend Software Engineer">
    <meta name="twitter:description" content="Backend Software Engineer specializing in Django & Laravel">
    <meta name="twitter:image" content="https://rovshenashirov.github.io/images/profile/avatar.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Icon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="/vendors/fontawesome/fontawesome.min.css">

    <!-- AOS Animation -->
    <link rel="stylesheet" href="/vendors/aos/aos.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/sections/hero.css">
    <link rel="stylesheet" href="/css/sections/stats.css">
    <link rel="stylesheet" href="/css/sections/about.css">
    <link rel="stylesheet" href="/css/sections/skills.css">
    <link rel="stylesheet" href="/css/sections/projects.css">
    <link rel="stylesheet" href="/css/sections/experience.css">
    <link rel="stylesheet" href="/css/sections/certificates.css">
    <link rel="stylesheet" href="/css/sections/contact.css">
    <link rel="stylesheet" href="/css/sections/footer.css">
    <link rel="stylesheet" href="/css/components/navigation.css">
    <link rel="stylesheet" href="/css/components/modal.css">
    <link rel="stylesheet" href="/css/components/project-card.css">
    <link rel="stylesheet" href="/css/components/lightbox.css">

    <!-- Google Analytics - Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1P3SSRW2LQ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-1P3SSRW2LQ');
    </script>

    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-NZ8R7X37');</script>
    <!-- End Google Tag Manager -->
</head>
<body>
    <!-- Loading Screen -->
    <div class="loading-screen" id="loadingScreen">
        <div class="loader"></div>
    </div>

    <slot />

    <!-- AOS Animation Script -->
    <script is:inline src="/vendors/aos/aos.min.js"></script>

    <!-- Custom JavaScript -->
    <script is:inline src="/js/main.js"></script>
    <script is:inline src="/js/sections/experience.js"></script>
    <script is:inline src="/js/sections/theme.js"></script>
    <script is:inline src="/js/sections/navigation.js"></script>
    <script is:inline src="/js/sections/hero.js"></script>
    <script is:inline src="/js/sections/stats.js"></script>
    <script is:inline src="/js/sections/language.js"></script>
    <script is:inline src="/js/components/modal.js"></script>
    <script is:inline src="/js/components/certificates.js"></script>

    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NZ8R7X37"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
</body>
</html>