---
const {t} = Astro.props;
---

<!-- Hero Section -->
<section class="hero" id="home">
    <div class="hero-bg"></div>
    <div class="hero-content">
        <div class="hero-text" data-aos="fade-right">
            <!-- Profile Image -->
            <div class="profile-image-container">
                <img src="/images/profile/avatar.png" alt="Rovshen Ashirov" class="profile-image"
                     onerror="this.src='/images/profile/avatar.svg'">
            </div>

            <h1>
                {t.hero.greeting}<br>
                <span class="gradient-text">Rovshen Ashirov</span>
            </h1>
            <p>
                <span class="typing-text" id="typingText"></span>
            </p>
            <p>
                <strong id="experienceYears">0+</strong>
                <span set:html={t.hero.description}></span>
            </p>
            <div class="hero-buttons">
                <a href="#contact" class="btn btn-primary">
                    <i class="fas fa-envelope"></i>
                    {t.hero.btnContact}
                </a>
                <a href="#projects" class="btn btn-secondary">
                    <i class="fas fa-briefcase"></i>
                    {t.hero.btnProjects}
                </a>
            </div>
        </div>
        <div class="hero-image" data-aos="fade-left">
            <div class="code-window floating">
                <div class="code-header">
                    <div class="code-dot"></div>
                    <div class="code-dot"></div>
                    <div class="code-dot"></div>
                </div>
                <pre class="code-content"><span class="code-keyword">class</span> <span class="code-function">SoftwareEngineer</span>:
    <span class="code-keyword">def</span> <span class="code-function">__init__</span>(self):
        self.name = <span class="code-string">"Rovshen Ashirov"</span>
        self.role = <span class="code-string">"Backend Developer"</span>
        self.experience = <span id="codeExperience" class="code-string">"0+ years"</span>
        self.location = <span class="code-string">"Uzbekistan"</span>

    <span class="code-keyword">def</span> <span class="code-function">skills</span>(self):
        <span class="code-keyword">return</span> [
            <span class="code-string">"Python"</span>, <span class="code-string">"PHP"</span>,
            <span class="code-string">"Django"</span>, <span class="code-string">"Laravel"</span>,
            <span class="code-string">"PostgreSQL"</span>, <span class="code-string">"Redis"</span>
        ]

    <span class="code-comment"># Building national platforms! 🚀</span></pre>
            </div>
        </div>
    </div>
</section>
